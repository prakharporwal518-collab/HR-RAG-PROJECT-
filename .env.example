# Claude API key (https://console.anthropic.com). Without it the app runs in
# "passage mode" and shows the matching handbook text instead of an AI answer.
ANTHROPIC_API_KEY=

# Secret that HR admins type in the "Upload policy" dialog. Leave empty to disable uploads.
ADMIN_TOKEN=change-me

# Optional tuning
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=low
# TOP_K=5
