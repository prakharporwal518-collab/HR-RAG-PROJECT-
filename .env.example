# ---------- AI answers ----------
# Set ONE of these keys. With neither, the app runs in "passage mode" and shows
# the matching handbook text instead of an AI-written answer.
#
# Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=low
#
# Gemini (free key at https://aistudio.google.com/apikey). Free-tier prompts may be
# used by Google to improve its products, so don't send real confidential documents.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
#
# If both keys are set, Claude is used unless you set LLM_PROVIDER=gemini.
# LLM_PROVIDER=claude

# ---------- Sign-in ----------
# Random string that signs session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# Set to true when serving over HTTPS.
COOKIE_SECURE=false

# Single sign-on (OpenID Connect). Leave empty for local "demo account" sign-in.
#   Google Workspace:   OIDC_ISSUER=https://accounts.google.com
#   Microsoft Entra ID: OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
#   Okta:               OIDC_ISSUER=https://<your-org>.okta.com
# Register the redirect URI http://localhost:8000/auth/callback with your provider.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_NAME=Google
# OIDC_REDIRECT_URI=https://hr.qorvexa.com/auth/callback
# AUTH_MODE=oidc   # defaults to "oidc" when OIDC_CLIENT_ID is set, otherwise "dev"

# ---------- Retrieval ----------
# EMBEDDINGS=off   # BM25 keyword search only (no embedding model download)
# TOP_K=5
